{
  "name": "ai-prepare-commit-msg",
  "image": "mcr.microsoft.com/vscode/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/devcontainers/features/ruby:2": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/prulloac/devcontainer-features/ollama:1": {}
  },
  "forwardPorts": [11434],
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "LITELLM_PROXY_MODEL": "${localEnv:LITELLM_PROXY_MODEL:ollama/llama3.2}",
    "LITELLM_PROXY_API_BASE": "${localEnv:LITELLM_PROXY_API_BASE:http://localhost:11434}",
    "LITELLM_PROXY_API_KEY": "${localEnv:LITELLM_PROXY_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort",
        "charliermarsh.ruff",
        "alexkrechik.cucumberautocomplete",
        "DavidAnson.vscode-markdownlint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  },
  "postCreateCommand": "uv sync --all-groups && uvx pre-commit install",
  "postStartCommand": "nohup sh -c 'ollama serve & until ollama list >/dev/null 2>&1; do sleep 1; done; case \"$LITELLM_PROXY_MODEL\" in ollama/*) ollama pull \"$(echo \"$LITELLM_PROXY_MODEL\" | cut -d/ -f2-)\";; esac; wait' > /tmp/ollama.log 2>&1 &"
}
